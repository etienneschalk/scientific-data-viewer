# Exclude sample data and test files
sample-data/**
test/**
*.test.js
*.test.ts

# Exclude development files
scripts/**
screenshots/**
.vscode-test/**
.vscode/**
*.log
*.tmp

# Exclude documentation that's not needed in the package
chats/**
# vsce matches "*.md" at the root only: "**/" excludes nested files too
**/*.md
!README.md
# Contributor docs, release notes, architecture diagrams: nothing reads them at
# runtime, and vsce rewrites the README's relative links to the repository
docs/**

# Media: the manifest and the code use icon.png and
# icon_viridis_bold_monochromatic.svg only. README screenshots are not needed:
# vsce rewrites their links to the GitHub repository in the packaged README.
media/icon.svg
media/icon_dark_bg.svg
media/icon_viridis_bold_monochromatic___old.svg
media/screenshots/**

# Python: ship only what the extension runs (get_data_info.py and its
# sdv_backend package, check_package_availability.py); sample data generators,
# notebooks, tests and tools stay out. vsce applies "!" patterns whatever their
# order (a negation wins over any exclusion), so they name .py files only, to
# keep __pycache__ out.
python/**
!python/get_data_info.py
!python/check_package_availability.py
!python/sdv_backend/**/*.py
python/**/__pycache__/**
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
.venv
venv

# Exclude Node.js files
node_modules/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Exclude IDE files
*.swp
*.swo
*~

# Exclude build artifacts
out/test/**

# TypeScript sources: shipped compiled in out/ (extension host: tsc, webview:
# esbuild bundle out/webview/webview.js). The webview stylesheet is loaded from
# src/ at runtime (WEBVIEW_STYLESHEET in src/panel/WebviewAssets.ts).
src/**
!src/panel/webview/styles.css
*.vsix

# Repository tooling and caches
.github/**
.ruff_cache/**
.pytest_cache/**
.gitignore
.nvmrc
.pre-commit-config.yaml
.secrets.baseline
*.sh
tsconfig*.json
pyproject.toml

# Exclude notebooks 
notebooks/**
