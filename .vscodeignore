# Exclude sample data and test files
sample-data/**
test/**
*.test.js
*.test.ts

# Exclude development files
scripts/**
.vscode-test/**
.vscode/**
*.log
*.tmp

# Exclude documentation that's not needed in the package
chats/**
*.md
!README.md

# Include media directory (for icons)
!media/**

# Exclude Python cache and temporary files
python/**/__pycache__/**
python/tests/**
python/tools/**
python/.golden/**
python/.pytest_cache/**
python/*.egg-info/**
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
.venv
venv

# Exclude Node.js files
node_modules/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Exclude IDE files
*.swp
*.swo
*~

# Exclude build artifacts
out/test/**

# Webview TypeScript sources: shipped as the esbuild bundle out/webview/webview.js
# (styles.css in the same folder is still loaded at runtime)
src/panel/webview/**/*.ts
src/panel/webview/tsconfig.json
*.vsix

# Exclude notebooks 
notebooks/**
